#!/bin/sh
# proxycmd - proxy tunnel using netcat

HELP=$(cat <<EOF
proxycmd - proxy tunnel using netcat
Usage: proxycmd [options] dest_host dest_port
  -H HOST       proxy host (defaults to ENV if set)
  -P PORT       proxy port (defaults to ENV if set or 3128)
  -p PROTOCOL   proxy protocol (defaults to ENV if set or connect)

ENV is first non-empty of \$http_proxy or \$https_proxy
PROTOCOL is any of 4,5 or connect (-X option of netcat)
EOF
)

HOST=
PORT=
PROTO=
while getopts :H:P:p:h OPT; do
	case "$OPT" in
	H)	HOST=$OPTARG ;;
	P)	PORT=$OPTARG ;;
	p)	PROTO=$OPTARG ;;
	h)	echo "$HELP" ; exit ;;
	*)	echo >&2 "error: unknown option -$OPTARG"; exit 1 ;;
	esac
done
shift "$((OPTIND-1))"
if [ $# -lt 2 ]; then
	echo >&2 "error: host and port(s) expected" ; exit
fi

if [ -z "$HOST" ]; then
	# shellcheck disable=SC2154 # $http_proxy and $https_proxy are external
	for PROXY in "$http_proxy" "$https_proxy" "$HTTP_PROXY" "$HTTPS_PROXY" ; do
		[ -z "$PROXY" ] && continue

		HOST=${PROXY#*://} ; HOST=${HOST%:*}
		# only set port and protocol if not already set
		[ -z "$PORT" ] && PORT=${PROXY##*:}
		[ -z "$PROTO" ] && PROTO=${PROXY%://*}
		
		[ -n "$HOST" ] && break
	done
fi
if [ -z "$HOST" ]; then
	echo >&2 "error: proxy host not set" ; exit 1
fi

PORT=${PORT:-3128}
PROTO=${PROTO:-connect}
case "$PROTO" in
	5|socks|socks5|socks5h)	PROTO=5 ;;
	4|socks4)				PROTO=4 ;;
	connect|http|https)		PROTO=connect ;;
	*)
		echo >&2 "error: invalid protocol: $PROTO" ; exit 1
		;;
esac

nc -X "$PROTO" -x "$HOST:$PORT" "$@"
