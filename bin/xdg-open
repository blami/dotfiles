#!/bin/sh
# xdg-open - Linux/WSL/MacOS multi file xdg-open wrapper
# NOTE: Depends on my ~/.zsh* for $OS, $WSL

[ $# -ge 1 ] || exit 1
BASENAME=$(basename "$0")

for FILE in $@; do
	if [ "$BASENAME" = "browser" ]; then
		case "$FILE" in
			*://*)  ;;
			*)      FILE="https://$FILE" ;;
		esac
	fi

	case "$OS" in
		linux|bsd)
			if [ -z "$WSL" ]; then
				/usr/bin/xdg-open "$FILE"
			else
				rundll32.exe url.dll,FileProtocolHandler "$FILE"
			fi
			;;
		macos)
			/usr/bin/open "$FILE"
			;;
	esac
done
